# NodeJS config
NODE_ENV=local|docker|production

# Application config
NAME="Tic Tac Toe API"
VERSION=0.1.0
PORT=3001
CORS=false
CORS_DOMAINS=

# OAuth
OAUTH_ISSUER=
OAUTH_AUDIENCE=https://tic-tac-toe-api

# JWT
JWT_SECRET=sAERgseomkwaWWEs
JWT_EXPIRES_IN=3600
JWT_ISS=tic_tac_toe-api
JWT_AUD=localhost:3001

# Database
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=
DATABASE_DB=tic_tac_toe
DATABASE_URL="postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_DB}?schema=public"

# Redis config
REDIS_CLUSTER=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_USERNAME=
REDIS_PASSWORD=
